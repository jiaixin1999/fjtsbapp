<div class="app">

  <!-- Top header: official wordmark -->
  <header class="topwrap">
    <div class="brandbar">
      <img class="wordmark" src="data:image/png;base64," alt="輔仁聖博敏神學院 — Fu Jen Faculty of Theology of St Robert Bellarmine">
    </div>
    <div class="toolbar">
      <span class="motto">Ad Maiorem Dei Gloriam</span>
      <button class="iconbtn" id="openSearch" aria-label="官網">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
      </button>
      <button class="iconbtn" id="openMenu" aria-label="選單">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <!-- Screens -->
  <main class="screens">

    <!-- HOME -->
    <section class="screen active" id="s-home">
      <div class="hero">
        <img src="https://theology.catholic.org.tw/J/images/file/data4588/data4588.jpg" alt="" onerror="this.style.display='none'">
        <div class="veil"></div>
        <div class="ornament">A.M.D.G.</div>
        <div class="htext">
          <div class="verse">「天主賜下了自己的獨生子，<br>是要使世人藉著祂而得救。」</div>
          <div class="ref">&mdash; 若望福音 3:16</div>
        </div>
      </div>
      <div class="dots"><span class="on"></span><span></span><span></span></div>

      <div class="sec-head"><span class="bar"></span><h2>快速服務</h2></div>
      <div class="grid">
        <a class="qa" data-url="https://theology.catholic.org.tw/J/data.php?id=303&preview=1" data-title="招生訊息">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></span>
          <span>招生訊息</span></a>
        <a class="qa" data-url="https://theology.catholic.org.tw/J/data.php?id=188" data-title="問題解答">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></span>
          <span>問題解答</span></a>
        <a class="qa" data-url="https://theology.catholic.org.tw/J/data.php?id=1489" data-title="招生簡介">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13l2 2 4-4"/></svg></span>
          <span>申請日間部</span></a>
        <a class="qa" data-url="https://theology.catholic.org.tw/J/data.php?id=74" data-title="教友推廣課程">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
          <span>教友推廣</span></a>
        <a class="qa" data-url="https://theology.catholic.org.tw/J/data.php?id=39" data-title="獎助學金">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></svg></span>
          <span>獎助學金</span></a>
        <a class="qa" href="https://amdgchinese.eoffering.org.tw/contents/project_ct?p_id=13&page=2" target="_blank" rel="noopener">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 12 6 5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/></svg></span>
