<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>輔仁聖博敏神學院</title>
<meta name="description" content="輔仁聖博敏神學院行動入口 — 招生、最新消息、研究與聯絡資訊">
<meta name="theme-color" content="#1b4f8f">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="輔神">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Noto+Serif+TC:wght@400;500;600;700;900&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --blue:#1b4f8f;
    --blue-deep:#0e2f5c;
    --blue-soft:#2c63a6;
    --gold:#c79a37;
    --gold-light:#e3c574;
    --cream:#eef3f9;
    --cream-2:#e3ecf6;
    --paper:#f7fafd;
    --ink:#1d2733;
    --ink-soft:#5d6b7d;
    --line:#d6e1ee;
    --shadow:0 8px 28px rgba(14,47,92,.14);
    --serif:"Noto Serif TC", serif;
    --latin:"Cormorant Garamond", serif;
    --sans:"Noto Sans TC", sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    font-family:var(--sans);
    background:
      radial-gradient(circle at 20% 0%, #2f6fb0 0%, transparent 55%),
      radial-gradient(circle at 90% 100%, #0a2547 0%, transparent 50%),
      #113560;
    color:var(--ink);
    display:flex;justify-content:center;align-items:center;
    min-height:100dvh;
  }

  /* ---- App shell ---- */
  .app{
    position:relative;
    width:100%;
    max-width:430px;
    height:100dvh;
    background:var(--paper);
    overflow:hidden;
    display:flex;flex-direction:column;
    box-shadow:0 30px 80px rgba(0,0,0,.55);
  }
  @media(min-width:480px){
    .app{
      height:min(900px,94dvh);
      border-radius:38px;
      border:10px solid #0a1a30;
      outline:2px solid #000;
    }
    body{padding:18px;}
  }

  /* ---- Top header (official wordmark) ---- */
  .topwrap{flex:0 0 auto;position:relative;z-index:30;box-shadow:0 4px 14px rgba(14,47,92,.25);}
  .brandbar{background:#ffffff;padding:calc(env(safe-area-inset-top) + 13px) 18px 11px;display:flex;justify-content:center;align-items:center;}
  .brandbar .wordmark{width:100%;max-width:330px;height:auto;display:block;}
  .toolbar{background:linear-gradient(135deg,var(--blue) 0%,var(--blue-deep) 100%);display:flex;align-items:center;gap:8px;padding:7px 12px;position:relative;}
  .toolbar::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,var(--gold),var(--gold-light),var(--gold));}
  .toolbar::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}
  .toolbar .motto{flex:1;font-family:var(--latin);font-style:italic;color:var(--gold-light);font-size:12.5px;letter-spacing:1.2px;padding-left:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .iconbtn{
    width:38px;height:38px;border:none;background:rgba(255,255,255,.1);
    color:var(--cream);border-radius:11px;display:flex;align-items:center;justify-content:center;
    cursor:pointer;transition:.2s;flex:0 0 auto;
  }
  .iconbtn:active{transform:scale(.92);background:rgba(255,255,255,.22);}
  .iconbtn svg{width:21px;height:21px;}

  /* ---- Scroll body ---- */
  .screens{flex:1;overflow:hidden;position:relative;}
  .screen{
    position:absolute;inset:0;overflow-y:auto;-webkit-overflow-scrolling:touch;
    padding-bottom:24px;opacity:0;pointer-events:none;transform:translateY(8px);
    transition:opacity .3s, transform .3s;
  }
  .screen.active{opacity:1;pointer-events:auto;transform:none;}
  .screen::-webkit-scrollbar{width:0;}

  /* ---- Section heading ---- */
  .sec-head{display:flex;align-items:center;gap:10px;margin:22px 18px 12px;}
  .sec-head .bar{width:4px;height:20px;border-radius:3px;background:linear-gradient(var(--gold),var(--blue));}
  .sec-head h2{font-family:var(--serif);font-size:19px;font-weight:900;color:var(--blue);letter-spacing:1px;}
  .sec-head .more{margin-left:auto;font-size:12px;color:var(--ink-soft);text-decoration:none;display:flex;align-items:center;gap:2px;cursor:pointer;}
  .sec-head .more svg{width:14px;height:14px;}

  /* ---- Hero ---- */
  .hero{position:relative;margin:14px 14px 0;border-radius:20px;overflow:hidden;height:210px;box-shadow:var(--shadow);background:linear-gradient(135deg,var(--blue-soft),var(--blue-deep));}
  .hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.85;}
  .hero .veil{position:absolute;inset:0;background:linear-gradient(0deg,rgba(10,30,60,.92) 0%,rgba(10,30,60,.15) 60%);}
  .hero .ornament{position:absolute;top:14px;left:14px;font-family:var(--latin);font-style:italic;color:var(--gold-light);font-size:13px;letter-spacing:1px;opacity:.9;}
  .hero .htext{position:absolute;left:18px;right:18px;bottom:16px;color:var(--cream);}
  .hero .htext .verse{font-family:var(--serif);font-size:17px;font-weight:600;line-height:1.5;text-shadow:0 2px 8px rgba(0,0,0,.5);}
  .hero .htext .ref{font-size:12px;color:var(--gold-light);margin-top:6px;}
  .dots{display:flex;gap:6px;justify-content:center;margin-top:12px;}
  .dots span{width:7px;height:7px;border-radius:50%;background:var(--line);transition:.3s;}
  .dots span.on{background:var(--blue);width:20px;border-radius:4px;}

  /* ---- Quick grid ---- */
  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px 4px;padding:0 12px;}
  .qa{
    background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:7px;
    padding:12px 4px;border-radius:16px;text-decoration:none;color:var(--ink);transition:.2s;
  }
  .qa:active{background:var(--cream-2);transform:scale(.95);}
  .qa .ic{width:48px;height:48px;border-radius:16px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(140deg,var(--cream),#fff);box-shadow:0 4px 10px rgba(27,79,143,.1),inset 0 0 0 1px var(--line);}
  .qa .ic svg{width:24px;height:24px;color:var(--blue);}
  .qa span{font-size:11.5px;font-weight:500;letter-spacing:.3px;text-align:center;line-height:1.2;}

  /* ---- Feature cards ---- */
  .hscroll{display:flex;gap:12px;overflow-x:auto;padding:4px 18px 8px;scroll-snap-type:x mandatory;}
  .hscroll::-webkit-scrollbar{height:0;}
  .fcard{
    flex:0 0 220px;scroll-snap-align:start;border-radius:18px;overflow:hidden;position:relative;
    height:130px;text-decoration:none;box-shadow:var(--shadow);cursor:pointer;
    background:linear-gradient(135deg,var(--blue-soft),var(--blue-deep));
  }
  .fcard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.82;}
  .fcard .v{position:absolute;inset:0;background:linear-gradient(0deg,rgba(10,30,60,.9),transparent 70%);}
  .fcard .t{position:absolute;left:14px;right:14px;bottom:12px;color:var(--cream);}
  .fcard .t b{font-family:var(--serif);font-size:16px;display:block;}
  .fcard .t small{font-size:11px;color:var(--gold-light);}

  /* ---- News list ---- */
  .news{margin:0 14px;display:flex;flex-direction:column;gap:10px;}
  .ni{
    display:block;text-decoration:none;color:inherit;background:#fff;border-radius:16px;padding:14px 16px;
    box-shadow:0 3px 12px rgba(27,79,143,.07);border:1px solid var(--line);transition:.2s;position:relative;overflow:hidden;cursor:pointer;
  }
  .ni::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(var(--gold),var(--blue));}
  .ni:active{transform:scale(.98);}
  .ni .meta{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
  .tag{font-size:10.5px;font-weight:700;color:var(--blue);background:var(--cream-2);padding:3px 9px;border-radius:20px;letter-spacing:.5px;}
  .ni .date{font-size:11px;color:var(--ink-soft);margin-left:auto;font-family:var(--latin);letter-spacing:.5px;}
  .ni h3{font-family:var(--serif);font-size:15px;font-weight:600;line-height:1.4;color:var(--ink);margin-bottom:4px;}
  .ni p{font-size:12.5px;color:var(--ink-soft);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}

  /* ---- Rows ---- */
  .rows{margin:0 14px;border-radius:16px;overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:0 3px 12px rgba(27,79,143,.06);}
  .row{display:flex;align-items:center;gap:14px;padding:15px 16px;text-decoration:none;color:var(--ink);border-bottom:1px solid var(--line);transition:.15s;cursor:pointer;}
  .row:last-child{border-bottom:none;}
  .row:active{background:var(--cream);}
  .row .ric{width:38px;height:38px;border-radius:11px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(140deg,var(--cream),#fff);box-shadow:inset 0 0 0 1px var(--line);}
  .row .ric svg{width:20px;height:20px;color:var(--blue);}
  .row .rtx{flex:1;min-width:0;}
  .row .rtx b{font-family:var(--serif);font-size:14.5px;font-weight:600;display:block;}
  .row .rtx small{font-size:11.5px;color:var(--ink-soft);}
  .row .chev{width:18px;height:18px;color:var(--line);flex:0 0 auto;}

  /* ---- Intro card ---- */
  .intro{margin:16px 14px;background:linear-gradient(150deg,var(--blue) 0%,var(--blue-deep) 100%);color:var(--cream);
    border-radius:20px;padding:22px 20px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
  .intro::after{content:"\271D";position:absolute;right:-10px;bottom:-30px;font-size:140px;opacity:.08;font-family:var(--latin);}
  .intro .k{font-family:var(--latin);font-style:italic;color:var(--gold-light);font-size:14px;letter-spacing:1px;}
  .intro h3{font-family:var(--serif);font-size:21px;font-weight:900;margin:6px 0 12px;letter-spacing:1px;}
  .intro p{font-size:13px;line-height:1.85;opacity:.92;}

  /* ---- Contact ---- */
  .contact{margin:0 14px;display:flex;flex-direction:column;gap:10px;}
  .cc{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 16px;text-decoration:none;color:var(--ink);box-shadow:0 3px 10px rgba(27,79,143,.05);}
  .cc:active{background:var(--cream);}
  .cc .ric{width:40px;height:40px;border-radius:12px;background:var(--cream-2);display:flex;align-items:center;justify-content:center;flex:0 0 auto;}
  .cc .ric svg{width:21px;height:21px;color:var(--blue);}
  .cc div b{display:block;font-size:11px;color:var(--ink-soft);font-weight:500;margin-bottom:2px;letter-spacing:.5px;}
  .cc div span{font-size:13.5px;font-weight:500;line-height:1.4;}
  .mapbox{margin:14px;border-radius:16px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow);height:170px;}
  .mapbox iframe{width:100%;height:100%;border:0;}
  .social{display:flex;justify-content:center;gap:14px;margin:6px 14px 0;}
  .sb{width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:var(--shadow);transition:.2s;}
  .sb:active{transform:scale(.9);}
  .sb svg{width:23px;height:23px;}

  .footnote{text-align:center;font-size:10.5px;color:var(--ink-soft);padding:22px 20px 8px;line-height:1.8;}
  .footnote a{color:var(--blue);text-decoration:none;cursor:pointer;}

  /* ---- Bottom nav ---- */
  .bottomnav{
    flex:0 0 auto;display:flex;background:linear-gradient(0deg,var(--blue-deep),var(--blue));
    padding:8px 4px calc(env(safe-area-inset-bottom) + 8px);position:relative;z-index:30;
    box-shadow:0 -3px 18px rgba(14,47,92,.4);
  }
  .bottomnav::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}
  .nav{flex:1;background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;
    color:rgba(238,243,249,.6);transition:.2s;padding:5px 0;border-radius:12px;}
  .nav svg{width:23px;height:23px;}
  .nav span{font-size:10px;font-weight:500;letter-spacing:.5px;}
  .nav.on{color:var(--gold-light);}
  .nav.on svg{filter:drop-shadow(0 0 6px rgba(227,197,116,.5));}

  /* ---- Drawer ---- */
  .scrim{position:absolute;inset:0;background:rgba(10,30,60,.55);backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:.3s;z-index:40;}
  .scrim.show{opacity:1;pointer-events:auto;}
  .drawer{
    position:absolute;top:0;right:0;bottom:0;width:86%;max-width:360px;background:var(--paper);z-index:50;
    transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;
    box-shadow:-12px 0 40px rgba(0,0,0,.4);
  }
  .drawer.show{transform:none;}
  .drawer .dhead{background:linear-gradient(135deg,var(--blue),var(--blue-deep));color:var(--cream);
    padding:calc(env(safe-area-inset-top) + 18px) 18px 18px;display:flex;align-items:center;gap:10px;}
  .drawer .dhead b{font-family:var(--serif);font-size:17px;flex:1;letter-spacing:1px;}
  .drawer .dbody{flex:1;overflow-y:auto;padding:8px 0 24px;}
  .drawer .dbody::-webkit-scrollbar{width:0;}
  .acc{border-bottom:1px solid var(--line);}
  .acc>button{width:100%;background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:12px;
    padding:15px 18px;color:var(--ink);font-family:var(--serif);font-size:15px;font-weight:600;}
  .acc>button .ai{width:30px;height:30px;border-radius:9px;background:var(--cream-2);display:flex;align-items:center;justify-content:center;flex:0 0 auto;}
  .acc>button .ai svg{width:17px;height:17px;color:var(--blue);}
  .acc>button .caret{margin-left:auto;width:18px;height:18px;color:var(--ink-soft);transition:.3s;}
  .acc.open>button .caret{transform:rotate(180deg);}
  .acc .sub{max-height:0;overflow:hidden;transition:max-height .35s ease;background:var(--cream);}
  .acc.open .sub{max-height:640px;}
  .acc .sub a{display:block;padding:12px 18px 12px 60px;text-decoration:none;color:var(--ink-soft);font-size:13.5px;border-top:1px solid var(--line);transition:.15s;cursor:pointer;}
  .acc .sub a:active{background:var(--cream-2);color:var(--blue);}
  .acc .sub a::before{content:"\00B7";color:var(--gold);margin-right:8px;font-weight:700;}

  /* ---- In-app webview ---- */
  .webview{position:absolute;inset:0;background:var(--paper);z-index:60;display:flex;flex-direction:column;
    transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);}
  .webview.show{transform:none;}
  .wvhead{flex:0 0 auto;background:linear-gradient(135deg,var(--blue),var(--blue-deep));color:var(--cream);
    padding:calc(env(safe-area-inset-top) + 12px) 10px 12px;display:flex;align-items:center;gap:8px;
    box-shadow:0 2px 10px rgba(14,47,92,.4);}
  .wvhead .wvtitle{flex:1;min-width:0;font-family:var(--serif);font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .wvframe{flex:1;position:relative;background:#fff;}
  .wvframe iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}
  .wvhint{position:absolute;left:0;right:0;bottom:0;background:rgba(14,47,92,.92);color:var(--cream);
    font-size:11px;text-align:center;padding:9px 12px;letter-spacing:.3px;display:flex;align-items:center;justify-content:center;gap:6px;}
  .wvhint svg{width:14px;height:14px;flex:0 0 auto;}
  .wvspin{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:34px;height:34px;
    border:3px solid var(--cream-2);border-top-color:var(--blue);border-radius:50%;animation:spin 1s linear infinite;}
  @keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg);}}
</style>
</head>
